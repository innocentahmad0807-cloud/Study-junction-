<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Study Junction | Free Educational Website</title>

<meta name="description"
content="Study Junction - Class 1 to 10 Maths, Science, English notes, questions, answers and quizzes.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, sans-serif;
    background:#f7f9fc;
    color:#172033;
}

/* HEADER */

header{
    background:white;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.navbar{
    max-width:1100px;
    margin:auto;
    padding:18px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:25px;
    font-weight:bold;
    color:#172033;
}

.logo span{
    color:#2563eb;
}

nav a{
    text-decoration:none;
    color:#172033;
    margin-left:22px;
    font-weight:bold;
}

nav a:hover{
    color:#2563eb;
}

/* HERO */

.hero{
    background:linear-gradient(135deg,#eaf2ff,#ffffff);
    padding:80px 20px;
}

.hero-content{
    max-width:1100px;
    margin:auto;
    text-align:center;
}

.hero h1{
    font-size:50px;
    margin-bottom:20px;
}

.hero h1 span{
    color:#2563eb;
}

.hero p{
    font-size:19px;
    color:#667085;
    max-width:700px;
    margin:auto;
}

.buttons{
    margin-top:30px;
}

.btn{
    display:inline-block;
    padding:13px 23px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    margin:5px;
}

.primary{
    background:#2563eb;
    color:white;
}

.secondary{
    background:white;
    color:#172033;
    border:1px solid #ccd3df;
}

/* SECTIONS */

section{
    padding:70px 20px;
}

.container{
    max-width:1100px;
    margin:auto;
}

.title{
    text-align:center;
    margin-bottom:40px;
}

.title h2{
    font-size:35px;
    margin-bottom:8px;
}

.title p{
    color:#667085;
}

/* CLASS CARDS */

.classes{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:18px;
}

.class-card{
    background:white;
    padding:25px 15px;
    text-align:center;
    border-radius:12px;
    border:1px solid #e3e7ee;
    transition:.3s;
    cursor:pointer;
}

.class-card:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 25px rgba(0,0,0,.1);
}

.class-card h3{
    font-size:20px;
    margin-bottom:8px;
}

.class-card p{
    color:#667085;
    font-size:14px;
}

/* SUBJECTS */

.subject-section{
    background:#eef3f9;
}

.subjects{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.subject{
    background:white;
    padding:30px 20px;
    text-align:center;
    border-radius:15px;
}

.subject .icon{
    font-size:45px;
}

.subject h3{
    margin:12px 0;
}

.subject p{
    color:#667085;
}

/* NOTES */

.notes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
    align-items:center;
}

.notes-box{
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,.05);
}

.notes-box h2{
    font-size:32px;
    margin-bottom:15px;
}

.notes-box p{
    color:#667085;
}

.note-list{
    margin-top:20px;
}

.note-list div{
    background:#f4f7fb;
    padding:13px;
    margin:10px 0;
    border-radius:8px;
}

/* QUIZ */

.quiz{
    background:#eef3f9;
}

.quiz-box{
    max-width:650px;
    margin:auto;
    background:white;
    padding:35px;
    text-align:center;
    border-radius:15px;
}

.quiz-box h2{
    margin-bottom:20px;
}

.options{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.options button{
    padding:15px;
    background:white;
    border:1px solid #ccd3df;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}

.options button:hover{
    background:#2563eb;
    color:white;
}

#result{
    margin-top:20px;
    font-weight:bold;
}

/* CONTACT */

.contact{
    text-align:center;
}

.contact p{
    color:#667085;
    margin:15px 0 25px;
}

/* FOOTER */

footer{
    background:#111827;
    color:white;
    padding:30px 20px;
    text-align:center;
}

footer p{
    color:#b8c0cc;
    margin-top:8px;
}

/* MOBILE */

@media(max-width:800px){

    nav{
        display:none;
    }

    .hero h1{
        font-size:38px;
    }

    .classes{
        grid-template-columns:repeat(2,1fr);
    }

    .subjects{
        grid-template-columns:1fr 1fr;
    }

    .notes{
        grid-template-columns:1fr;
    }
}

@media(max-width:500px){

    .classes{
        grid-template-columns:1fr;
    }

    .subjects{
        grid-template-columns:1fr;
    }

    .options{
        grid-template-columns:1fr;
    }

    .hero{
        padding:60px 15px;
    }

    .hero h1{
        font-size:32px;
    }
}
</style>
</head>

